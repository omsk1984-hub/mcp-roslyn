<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xunit v3 runs on Microsoft.Testing.Platform (MTP). Tests are executed by running
         the compiled test executable directly, not via `dotnet test`: on the .NET 10 SDK
         the VSTest target is no longer supported for MTP apps, and the new `dotnet test`
         experience has no working opt-in in this SDK version (10.0.401).
         See .roo/rules-code/01-test.md for the canonical command. -->
    <TestingPlatformDotnetHostSupport>true</TestingPlatformDotnetHostSupport>
    <!-- Replace xunit's auto-generated entry point with our own (TestEntryPoint.cs) that
         always routes through the MTP host, so the MTP extensions (notably CodeCoverage)
         are registered for direct runs too. The auto entry point registers extensions only
         on its server and internal-msbuild-node branches. -->
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
  </PropertyGroup>

  <!-- The VSTest bridge packages (Microsoft.NET.Test.Sdk, xunit.runner.visualstudio,
       coverlet.collector) are removed: they are inert for MTP apps on .NET 10.
       Coverage is provided by the MTP-native Microsoft.Testing.Extensions.CodeCoverage
       package via its coverage option (see .github/workflows/ci.yml). -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Fixtures\TestSolution\**" />
    <Compile Remove="Fixtures\TestSolutionAlt\**" />
    <Compile Remove="Fixtures\LegacySolution\**" />
    <Compile Remove="Fixtures\GraphReader\**" />
    <Compile Remove="Fixtures\FilterableSolution\**" />
    <Compile Remove="Fixtures\RazorFixture\**" />
    <Compile Remove="Fixtures\PropsFixture\**" />
    <None Include="Fixtures\TestSolution\**" CopyToOutputDirectory="Never" />
    <None Include="Fixtures\TestSolutionAlt\**" CopyToOutputDirectory="Never" />
    <None Include="Fixtures\LegacySolution\**" CopyToOutputDirectory="Never" />
    <None Include="Fixtures\GraphReader\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\FilterableSolution\**" CopyToOutputDirectory="Never" />
    <None Include="Fixtures\RazorFixture\**" CopyToOutputDirectory="Never" />
    <None Include="Fixtures\PropsFixture\**" CopyToOutputDirectory="Never" />
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RoslynCodeLens\RoslynCodeLens.csproj" />
  </ItemGroup>

</Project>