root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# === Structural rules: suppressed by design decision (2026-10-29) ===

# MA0048: Codebase intentionally groups related records/enums with their main type
#         in a single file (e.g., records in Models/*.cs, enums in StackTrace/*.cs).
#         Renaming ~20 files or splitting types into separate files would be pure churn
#         with zero behavior change.
dotnet_diagnostic.MA0048.severity = none

# MA0051: The 60-line method limit is too strict for this codebase. 20 methods exceed
#         it by 1-70 lines. Extracting sub-methods from all of them risks behavior
#         changes and is not justified by the marginal readability gain.
dotnet_diagnostic.MA0051.severity = none

# MA0009: All flagged regexes operate on trusted internal input (stack trace strings,
#         project file names, type names) — not on user-facing or network input.
#         The ReDoS risk is theoretical and not applicable in this context.
dotnet_diagnostic.MA0009.severity = none

# ERP022: The flagged catch blocks are intentional best-effort operations that return
#         a default value on failure (e.g., returning Array.Empty<T>() when a project
#         classification fails). Adding exception observation (logging/rethrow) would
#         change behavior and is not desired.
dotnet_diagnostic.ERP022.severity = none

# ZA0601: "LINQ method inside a loop allocates on every iteration". The vast majority of
#         flagged sites are FALSE POSITIVES: the LINQ source depends on the loop variable
#         (e.g. `project.AdditionalDocuments` inside `foreach (var project in ...)`,
#         `group.ToList()`, `deps.Where(...)`, `type.GetMembers(...)`). Hoisting such LINQ
#         out of the loop would change behavior (a bug), not fix it. The few loop-invariant
#         cases sit in non-hot MCP tool code paths (not per-request hot loops), where the
#         per-iteration allocation is negligible. A mechanical fix is not safe.
dotnet_diagnostic.ZA0601.severity = none

# EPC12: "only ex.Message is observed in exception block". All flagged catch blocks
#         intentionally log/record the message (and sometimes the type name) for
#         diagnostics; the full stack trace is not needed at these best-effort sites.
#         Adding stack-trace observation would be noise, not a fix.
dotnet_diagnostic.EPC12.severity = none

# EPS05: "Use in-modifier for passing readonly struct". This is a micro-optimization
#         (pass-by-in vs pass-by-value) with no correctness impact. Changing 8 method
#         signatures for a negligible perf gain is not justified.
dotnet_diagnostic.EPS05.severity = none

# EPS06: "Expression causes a hidden copy of a struct". Micro-optimization; several
#         flagged sites are false positives (e.g. ReadOnlySpan is a ref struct and cannot
#         be meaningfully copied). Not worth the churn.
dotnet_diagnostic.EPS06.severity = none

# ZA0501: "Value type boxed to IEnumerable inside a loop". Several flagged sites are
#         false positives (the reported boxed type does not match the expression, e.g.
#         'CancellationToken boxed to IImmutableSet<Project>?'). The rest are negligible
#         micro-allocations in non-hot code. A mechanical fix is not safe.
dotnet_diagnostic.ZA0501.severity = none

# MA0016: "Prefer using collection abstraction instead of implementation". The flagged
#         members (Dictionary, List) are internal implementation details where the
#         concrete type is part of the API contract (e.g. JSON-serialized model, or a
#         return type callers rely on). Switching to IReadOnly* adds churn with no gain.
dotnet_diagnostic.MA0016.severity = none

# MA0008: "Add StructLayoutAttribute". The flagged record structs are pure data holders
#         (CognitiveResult, Thresholds), not interop/serialization types. StructLayout is
#         unnecessary and would be misleading.
dotnet_diagnostic.MA0008.severity = none

# MA0061: "Method overrides should not change default values". The flagged override
#         (StructuredErrorToolWrapper.InvokeAsync) overrides a method declared in the
#         ModelContextProtocol NuGet package (metadata) whose CancellationToken parameter
#         has a default of null. In C# an overriding method CANNOT specify a default value
#         — it is inherited from the base — so the source is correct and the warning is a
#         false positive that cannot be fixed without changing the external base type.
dotnet_diagnostic.MA0061.severity = none

# RCS1194: "Implement exception constructors". McpToolException's primary constructor
#         requires a ToolErrorCode (a domain-specific, non-optional parameter), so the
#         standard Exception constructors (message-only, message+inner, serialization)
#         cannot be implemented without inventing a code value. Not applicable here.
dotnet_diagnostic.RCS1194.severity = none

# === Test-specific suppressions ===

# MA0004 conflicts with xUnit1030: MA0004 requires ConfigureAwait(false) in async code,
# but xUnit1030 forbids ConfigureAwait(false) in test methods. In tests, the xunit
# analyzer wins — MA0004 is suppressed.
#
# xUnit1051: "Calls to methods which accept CancellationToken should use
# TestContext.Current.CancellationToken". This is a SEMANTIC fix, not a mechanical one:
# the warning is reported at the test method declaration, but the fix requires
# threading TestContext.Current.CancellationToken into the specific calls inside the
# method body that accept a CancellationToken parameter. A mechanical (regex-based)
# fix is not safe — it would insert the token into the wrong location (e.g., the method
# signature instead of the call site). The 386 affected sites span 33 files with
# varying method signatures and multi-line calls. The tests work correctly without
# CancellationToken; this is a "should" recommendation for cancellation responsiveness,
# not a correctness issue.
[tests/**.cs]
dotnet_diagnostic.MA0004.severity = none
dotnet_diagnostic.xUnit1051.severity = none
