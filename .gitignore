# Build outputs
bin/
obj/
Debug/
Release/

# Visual Studio
*.user
*.suo
.vs/

# VS Code
.vscode/

# NuGet
packages/
*.nupkg

# Test results
TestResults/

# Build artifacts
artifacts/

# Local publish output (dotnet publish -o publish). The MCP client launches the
# server from this path, but the binaries themselves are build output, not source.
publish/

# Benchmark results
BenchmarkDotNet.Artifacts/

# Git worktrees
.worktrees/

# npm launcher package. The `bin/` rule above is meant for .NET build output; npm/bin
# holds the launcher script and must be tracked. Git cannot re-include a file whose
# parent directory is excluded, so the directory itself has to be negated first.
!npm/bin/
npm/node_modules/
npm/*.tgz

# Docusaurus
docs/site/node_modules/
docs/site/build/
docs/site/.docusaurus/
docs/site/docs/tools/

# Screenshots and page snapshots the Playwright MCP server writes into the working directory.
.playwright-mcp/
